<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults autowire="true" autoconfigure="true"/>
        <prototype namespace="Frosh\MailArchive\" resource="../../"
                   exclude="../../Decorator/MailerTransportLoaderDecorator.php"/>

        <service id="Frosh\MailArchive\Decorator\MailerTransportLoaderDecorator"
                 decorates="Shopware\Commercial\B2B\QuoteManagement\Domain\Mail\QuoteMailerTransportLoaderDecorator"
                 decoration-on-invalid="ignore">
            <argument type="service" id=".inner"/>
            <argument type="service" id="event_dispatcher"/>
        </service>
    </services>
</container>
