<sw-page>
    <template #search-bar>
        <sw-search-bar
            initialSearchType="Mail Archive"
            :initialSearch="term"
            @search="onSearch"
        >
        </sw-search-bar>
    </template>

    <template #smart-bar-header>
        <h2>
            {{ $tc('sw-settings.index.title') }}
            <sw-icon
                name="regular-chevron-right-xs"
                size="16px"
                deprecated
            />
            {{ $tc('frosh-mail-archive.title') }}
        </h2>
    </template>

    <template #content>
        <frosh-mail-archive-listing
            :items="items"
            :isLoading="isLoading"
            :sort-by="currentSortBy"
            :sort-direction="sortDirection"
            @refresh-items="getList"
            @open-detail="openDetail"
            @page-change="onPageChange"
            @column-sort="onSortColumn"
        />
    </template>

    <template #sidebar>
        <sw-sidebar>
            <sw-sidebar-item
                icon="regular-undo"
                :title="$tc('frosh-mail-archive.list.sidebar.refresh')"
                @click="onRefresh"
            >
            </sw-sidebar-item>
            <sw-sidebar-filter-panel
                entity="frosh_mail_archive"
                :store-key="storeKey"
                :filters="listFilters"
                :defaults="defaultFilters"
                @criteria-changed="updateCriteria"
            />
        </sw-sidebar>
    </template>
</sw-page>